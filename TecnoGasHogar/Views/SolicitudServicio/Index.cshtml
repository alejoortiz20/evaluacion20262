@model IEnumerable<SolicitudServicio>

@{
    ViewData["Title"] = "Listado de Solicitudes";

    var total = Model.Count();
    var instalaciones = Model.Count(s => s.TipoServicio == "Instalación");
    var fugas = Model.Count(s => s.TipoServicio == "Fuga");

    string Badge(string tipo) => tipo switch
    {
        "Instalación" => "success",
        "Mantenimiento" => "primary",
        "Revisión" => "warning",
        "Fuga" => "danger",
        _ => "secondary"
    };
}

<section class="tgh-band mb-4">
    <div>
        <span class="tgh-eyebrow">TecnoGas Hogar</span>
        <h1 class="tgh-title">Solicitudes de servicio</h1>
        <p class="tgh-lead">Consulta las solicitudes de mantenimiento e instalación de artefactos a gas registradas por nuestros clientes.</p>
    </div>
    <a asp-action="Create" class="btn btn-flame btn-lg px-4">
        + Registrar solicitud
    </a>
</section>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" /><path d="M8 12l2.5 2.5L16 9" />
        </svg>
        <div>@TempData["MensajeExito"]</div>
    </div>
}

@if (!Model.Any())
{
    <div class="tgh-empty">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#9fb3c0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2Z" />
            <path d="M14 2v6h6" /><path d="M9 13h6" /><path d="M9 17h6" />
        </svg>
        <h4 class="mt-3 text-dark">Aún no hay solicitudes registradas</h4>
        <p class="mb-3">Registra la primera solicitud de servicio de un cliente para verla aquí.</p>
        <a asp-action="Create" class="btn btn-flame">+ Registrar nueva solicitud</a>
    </div>
}
else
{
    <div class="tgh-stats mb-4">
        <div class="tgh-stat">
            <span class="tgh-stat-icon is-gas">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 18 0H3Z" /><path d="M12 3v9" /></svg>
            </span>
            <div>
                <div class="tgh-stat-value">@total</div>
                <div class="tgh-stat-label">Solicitudes totales</div>
            </div>
        </div>
        <div class="tgh-stat">
            <span class="tgh-stat-icon is-flame">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c.6 4.6-2.8 6-3.5 9.2A4 4 0 0 0 12 19a4 4 0 0 0 3.6-2.9C16 13.3 15 9.8 12 2Z" /></svg>
            </span>
            <div>
                <div class="tgh-stat-value">@fugas</div>
                <div class="tgh-stat-label">Atención por fuga</div>
            </div>
        </div>
        <div class="tgh-stat">
            <span class="tgh-stat-icon is-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><rect x="3" y="9" width="18" height="4" /></svg>
            </span>
            <div>
                <div class="tgh-stat-value">@instalaciones</div>
                <div class="tgh-stat-label">Instalaciones</div>
            </div>
        </div>
    </div>

    <div class="tgh-card">
        <div class="table-responsive">
            <table class="table table-hover tgh-table mb-0">
                <thead>
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(model => model.First().Id)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.First().Cliente)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.First().Telefono)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.First().Distrito)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.First().TipoServicio)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.First().Descripcion)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.First().FechaRegistro)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var solicitud in Model)
                    {
                        <tr>
                            <td><span class="tgh-id">@solicitud.Id</span></td>
                            <td class="tgh-cliente">@solicitud.Cliente</td>
                            <td>@solicitud.Telefono</td>
                            <td>@solicitud.Distrito</td>
                            <td>
                                <span class="badge rounded-pill text-bg-@Badge(solicitud.TipoServicio) tgh-badge-brand">@solicitud.TipoServicio</span>
                            </td>
                            <td>@solicitud.Descripcion</td>
                            <td><span class="text-nowrap">@solicitud.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}