@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TecnoGasHogar</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TecnoGasHogar.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark tgh-navbar">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand tgh-brand" asp-area="" asp-controller="SolicitudServicio" asp-action="Index">
                    <span class="tgh-brand-mark" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2c.6 4.6-2.8 6-3.5 9.2A4 4 0 0 0 12 19a4 4 0 0 0 3.6-2.9C16 13.3 15 9.8 12 2Z" />
                            <path d="M9 6.5C6 8.6 4 11.3 4 14a8 8 0 1 0 16 0c0-2.6-1.8-5.2-4.6-7.2" />
                        </svg>
                    </span>
                    <span>
                        TecnoGas Hogar
                        <span class="tgh-brand-sub">Servicio técnico a gas</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-md-inline-flex justify-content-end" id="mainNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link @(controller == "SolicitudServicio" && action == "Index" ? "active" : "")" asp-area="" asp-controller="SolicitudServicio" asp-action="Index">Solicitudes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "SolicitudServicio" && action == "Create" ? "active" : "")" asp-area="" asp-controller="SolicitudServicio" asp-action="Create">Registrar Solicitud</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4 px-lg-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="tgh-footer py-4 mt-4">
        <div class="container px-lg-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>TecnoGas Hogar &copy; 2026</span>
            <span class="small">Instalación y mantenimiento de artefactos a gas</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>